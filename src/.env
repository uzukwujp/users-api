# For local development only
# In Kubernetes, these will be mounted as environment variables from secrets

# AWS Configuration
AWS_REGION=eu-west-2
# Optional: When running locally, provide AWS credentials
# In Kubernetes with IAM roles for service accounts, these are not needed
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application Configuration (should be provided via Kubernetes secrets in production)
DYNAMODB_TABLE=Users
S3_BUCKET=kubernete-api
S3_AVATAR_PREFIX=avatars/

# Flask Configuration
DEBUG=False
HOST=0.0.0.0
PORT=5000